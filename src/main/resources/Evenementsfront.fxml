<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: #f0f4f0;"
            stylesheets="@activitesfront.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.EVENTfront">

    <!-- ══════════════════ NAVBAR ══════════════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color:#ffffff;-fx-border-color:#e2e8f0;-fx-border-width:0 0 1 0;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.02),10,0,0,2);">
                <padding><Insets bottom="16" left="32" right="32" top="16"/></padding>
                <HBox alignment="CENTER" spacing="10">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16"/>
                    <Label style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#0f172a;" text="TravelMate"/>
                    <Label style="-fx-background-color:#ff8c42;-fx-text-fill:white;-fx-background-radius:12;-fx-padding:4 10;-fx-font-size:10;-fx-font-weight:bold;" text="PRO"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-padding:0 0 0 20;">
                    <HBox fx:id="btnDestinations" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="🌍"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Destinations"/>
                    </HBox>
                    <HBox fx:id="btnHebergements" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="🏨"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Hébergements"/>
                    </HBox>
                    <HBox fx:id="btnCategories" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="📑"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Catégories"/>
                    </HBox>
                    <HBox fx:id="btnActivites" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="🏄"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Activités"/>
                    </HBox>
                    <HBox fx:id="btnEvenements" alignment="CENTER" spacing="8" style="-fx-background-color:rgba(255,140,66,0.1);-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;-fx-border-color:#ff8c42;-fx-border-width:1;-fx-border-radius:12;">
                        <Label style="-fx-font-size:16;" text="🎉"/>
                        <Label style="-fx-text-fill:#ff8c42;-fx-font-weight:600;-fx-font-size:13;" text="Événements"/>
                    </HBox>
                    <HBox fx:id="btnVoyages" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="✈️"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Voyages"/>
                    </HBox>
                    <HBox fx:id="btnBudgets" alignment="CENTER" spacing="8" style="-fx-background-color:transparent;-fx-background-radius:12;-fx-padding:6 10;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="💰"/>
                        <Label style="-fx-text-fill:#475569;-fx-font-weight:500;-fx-font-size:13;" text="Budgets"/>
                    </HBox>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane>
                    <HBox fx:id="btnNotifications" alignment="CENTER" style="-fx-background-color:#f1f5f9;-fx-background-radius:50%;-fx-min-width:40;-fx-min-height:40;-fx-cursor:hand;">
                        <Label style="-fx-font-size:16;" text="🔔"/>
                    </HBox>
                </StackPane>
                <HBox fx:id="userProfileBox" alignment="CENTER" minWidth="140" spacing="10" style="-fx-background-color:#f1f5f9;-fx-background-radius:25;-fx-padding:6 12 6 6;-fx-cursor:hand;">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16"/>
                    <VBox spacing="0">
                        <Label fx:id="lblUserName" style="-fx-text-fill:#0f172a;-fx-font-weight:600;-fx-font-size:13;" text="Chargement..."/>
                        <Label fx:id="lblUserRole" style="-fx-text-fill:#64748b;-fx-font-size:10;" text="..."/>
                    </VBox>
                    <Label style="-fx-text-fill:#64748b;-fx-font-size:12;" text="▼"/>
                </HBox>
            </HBox>

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8"
                  style="-fx-background-color:#ffffff;-fx-border-color:#e2e8f0;-fx-border-width:0 0 1 0;-fx-padding:12 32;">
                <HBox fx:id="btnHome" alignment="CENTER" style="-fx-background-color:#f1f5f9;-fx-background-radius:12;-fx-min-width:40;-fx-min-height:40;-fx-cursor:hand;">
                    <Label style="-fx-font-size:18;-fx-text-fill:#475569;" text="🏠"/>
                </HBox>
                <Label style="-fx-text-fill:#94a3b8;-fx-font-size:14;" text="›"/>
                <Label style="-fx-text-fill:#475569;-fx-font-size:13;" text="Accueil"/>
                <Label style="-fx-text-fill:#94a3b8;-fx-font-size:14;" text="›"/>
                <Label style="-fx-background-color:#ff8c42;-fx-text-fill:white;-fx-background-radius:15;-fx-padding:4 14;-fx-font-size:12;-fx-font-weight:bold;" text="Événements"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnTranslate" onAction="#handleTranslate" style="-fx-background-color:#10b981;-fx-text-fill:white;-fx-background-radius:12;-fx-padding:4 12;-fx-font-size:11;-fx-cursor:hand;-fx-border-width:0;" text="🌐 Traduire" />
                <Label fx:id="lblDate" style="-fx-text-fill:#888;-fx-font-size:12;-fx-font-weight:500;" text="..."/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════════════ CONTENU PRINCIPAL ══════════════════ -->
    <!--
        AnchorPane comme conteneur du center :
        - Panneau droit ancré à droite (top/right/bottom = 0)
        - Panneau gauche ancré à gauche et à droite du panneau droit
        Cela garantit que les deux panneaux remplissent exactement la hauteur disponible.
    -->
    <center>
        <AnchorPane style="-fx-background-color:#f0f4f0;">

            <!-- ═══ PANNEAU DROIT (ancré à droite) ═══ -->
            <ScrollPane fx:id="rightScrollPane"
                        fitToWidth="true" fitToHeight="false"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background:transparent;-fx-background-color:transparent;-fx-border-color:transparent;"
                        AnchorPane.topAnchor="20" AnchorPane.rightAnchor="20"
                        AnchorPane.bottomAnchor="0"
                        prefWidth="290">
                <VBox spacing="14" style="-fx-padding:0 0 20 0;">
                    <!-- PieChart -->
                    <VBox spacing="10" style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:16;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.08),10,0,0,2);">
                        <Label style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#1a1a1a;" text="Répartition par Lieu"/>
                        <PieChart fx:id="pieChart" labelsVisible="false" legendVisible="true"
                                  style="-fx-background-color:transparent;"
                                  prefHeight="200" prefWidth="258"/>
                    </VBox>

                    <!-- Détail événement sélectionné -->
                    <VBox spacing="8" style="-fx-background-color:white;-fx-background-radius:16;-fx-padding:16;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.08),10,0,0,2);">
                        <Label style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:#888;" text="Événement sélectionné"/>
                        <Label fx:id="lblSelectedNom" style="-fx-font-size:14;-fx-font-weight:bold;-fx-text-fill:#1a1a1a;-fx-wrap-text:true;" text="—"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Circle fx:id="dotColor" fill="#ff6b00" radius="6"/>
                            <Label fx:id="lblSelectedDate" style="-fx-text-fill:#666;-fx-font-size:12;" text="—"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblSelectedPlaces" style="-fx-text-fill:#1a1a1a;-fx-font-weight:bold;-fx-font-size:12;" text="—"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size:12;" text="📍"/>
                            <Label fx:id="lblSelectedLieu" style="-fx-text-fill:#888;-fx-font-size:12;-fx-wrap-text:true;" text="—"/>
                        </HBox>
                        <Label style="-fx-text-fill:#bbb;-fx-font-size:10;-fx-wrap-text:true;" text="ℹ Cliquez sur un événement pour voir son détail."/>
                    </VBox>

                    <!-- Explorer activités -->
                    <VBox spacing="8" style="-fx-background-color:white;-fx-background-radius:12;-fx-padding:14;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.06),8,0,0,2);">
                        <Label style="-fx-font-size:12;-fx-font-weight:bold;-fx-text-fill:#888;" text="Explorer les activités"/>
                        <HBox alignment="CENTER_LEFT" onMouseClicked="#handleVersActivites" spacing="8"
                              style="-fx-cursor:hand;-fx-background-color:#fff3e8;-fx-background-radius:10;-fx-padding:10;">
                            <Label style="-fx-font-size:15;" text="🏄"/>
                            <Label style="-fx-text-fill:#ff6b00;-fx-font-weight:bold;-fx-font-size:12;" text="Voir toutes les Activités"/>
                        </HBox>
                    </VBox>

                    <!-- Reset filtres -->
                    <Button onAction="#handleResetFilters"
                            style="-fx-background-color:white;-fx-text-fill:#888;-fx-border-color:#ddd;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:10 20;-fx-cursor:hand;-fx-font-size:12;-fx-max-width:Infinity;"
                            text="↺ Réinitialiser les filtres" maxWidth="Infinity"/>

                    <Button fx:id="btnAllEvenements" onAction="#handleShowAllEvenements"
                            visible="false" managed="false"
                            style="-fx-background-color:#ff6b00;-fx-text-fill:white;-fx-border-radius:10;-fx-background-radius:10;-fx-padding:10 20;-fx-cursor:hand;-fx-font-size:12;-fx-max-width:Infinity;-fx-font-weight:bold;"
                            text="← Voir tous les événements" maxWidth="Infinity"/>
                </VBox>
            </ScrollPane>

            <!-- ═══ PANNEAU GAUCHE (ancré à gauche, s'arrête avant le panneau droit) ═══ -->
            <VBox spacing="16"
                  AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
                  AnchorPane.rightAnchor="330" AnchorPane.bottomAnchor="0">

                <!-- Header + filtres -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color:white;-fx-background-radius:12;-fx-padding:14 20;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.06),8,0,0,2);">
                    <Label style="-fx-font-size:20;-fx-text-fill:#ff6b00;" text="🎉"/>
                    <Label fx:id="titleLabel" style="-fx-font-size:18;-fx-font-weight:bold;-fx-text-fill:#1a1a1a;" text="Explorez les Événements"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="filterLieuCombo" promptText="Lieu"
                              style="-fx-background-color:white;-fx-border-color:#ddd;-fx-border-radius:8;-fx-background-radius:8;"/>
                    <ComboBox fx:id="filterMoisCombo" promptText="Mois"
                              style="-fx-background-color:white;-fx-border-color:#ddd;-fx-border-radius:8;-fx-background-radius:8;"/>
                    <Button onAction="#handleResetFilters"
                            style="-fx-background-color:white;-fx-text-fill:#888;-fx-border-color:#ddd;-fx-border-radius:8;-fx-background-radius:8;-fx-padding:8 14;-fx-cursor:hand;-fx-font-size:14;"
                            text="↺"/>
                </HBox>

                <!-- Stats -->
                <HBox spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:12;-fx-padding:12 16;-fx-border-left-width:4;-fx-border-color:#ff6b00 transparent transparent transparent;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.06),8,0,0,2);">
                        <Label style="-fx-text-fill:#999;-fx-font-size:10;-fx-font-weight:bold;" text="ÉVÉNEMENTS TOTAUX"/>
                        <Label fx:id="lblTotalEvenements" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#1a1a1a;" text="0"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:12;-fx-padding:12 16;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.06),8,0,0,2);">
                        <Label style="-fx-text-fill:#999;-fx-font-size:10;-fx-font-weight:bold;" text="PROCHAIN ÉVÉNEMENT"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label style="-fx-font-size:14;" text="📅"/>
                            <VBox spacing="1">
                                <Label fx:id="lblDateProchain" style="-fx-text-fill:#888;-fx-font-size:11;" text="—"/>
                                <Label fx:id="lblNomProchain" style="-fx-text-fill:#1a1a1a;-fx-font-weight:bold;-fx-font-size:12;" text="—"/>
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:white;-fx-background-radius:12;-fx-padding:12 16;-fx-effect:dropshadow(three-pass-box,rgba(0,0,0,0.06),8,0,0,2);">
                        <Label style="-fx-text-fill:#999;-fx-font-size:10;-fx-font-weight:bold;" text="PLACES DISPONIBLES"/>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size:12;" text="🎟️"/>
                            <Label fx:id="lblTopLieu" style="-fx-text-fill:#1a1a1a;-fx-font-size:12;" text="—"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblTopPlaces" style="-fx-text-fill:#1a1a1a;-fx-font-weight:bold;-fx-font-size:12;" text="—"/>
                        </HBox>
                        <ProgressBar fx:id="progressTop" maxWidth="Infinity" progress="0.0"
                                     style="-fx-accent:#ff6b00;-fx-background-radius:3;"/>
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label style="-fx-font-size:12;" text="📍"/>
                            <Label fx:id="lblTopNom" style="-fx-text-fill:#888;-fx-font-size:11;" text="—"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Titre section -->
                <Label style="-fx-font-size:16;-fx-font-weight:bold;-fx-text-fill:#1a1a1a;" text="Liste des Événements"/>

                <!-- ScrollPane de la grille — prend tout l'espace vertical restant -->
                <ScrollPane fx:id="gridScrollPane"
                            fitToWidth="true" fitToHeight="false"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background:transparent;-fx-background-color:transparent;-fx-border-color:transparent;">
                    <GridPane fx:id="evenementsGrid" hgap="14" vgap="14"
                              maxWidth="Infinity" prefWidth="1"
                              HBox.hgrow="ALWAYS"
                              style="-fx-padding:4 4 20 4;"/>
                </ScrollPane>
            </VBox>

        </AnchorPane>
    </center>

    <!-- Barre de bas -->
    <bottom>
        <Region maxWidth="Infinity" minHeight="3" prefHeight="3"
                style="-fx-background-color:linear-gradient(to right,rgba(245,166,35,0.5),rgba(255,107,0,0.5),rgba(99,102,241,0.5));"/>
    </bottom>

</BorderPane>
