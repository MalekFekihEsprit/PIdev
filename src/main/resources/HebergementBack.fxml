                <VBox spacing="28"><padding><Insets bottom="60" left="36" right="36" top="36" /></padding>

                    <VBox spacing="8">
                        <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a" text="Gestion des Hébergements" />
