                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 24; -fx-font-weight: 600; -fx-text-fill: #0f172a" text="Liste des Hébergements" />
                            <Label fx:id="lblHebergementCount" style="-fx-background-color: rgba(16,185,129,0.15); -fx-text-fill: #10b981; -fx-background-radius: 20; -fx-padding: 6 14; -fx-font-weight: 600; -fx-font-size: 11" text="0 hébergements" />
                            <Region HBox.hgrow="ALWAYS" />
                            <HBox spacing="8">
                                <Button fx:id="btnAjouter" style="-fx-background-color: #10b981; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Ajouter" />
                                <Button fx:id="btnSupprimer" style="-fx-background-color: #ef4444; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="🗑️ Supprimer" />
                                <HBox fx:id="btnSearch" alignment="CENTER" style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;">
                                    <Label style="-fx-font-size: 16; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🔍" />
                                </HBox>
                                <HBox fx:id="btnFilter" alignment="CENTER" style="-fx-background-color: #e2e8f0; -fx-background-radius: 8; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;">
                                    <Label style="-fx-font-size: 16; -fx-text-fill: #0f172a; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📊" />
                                </HBox>
                            </HBox>
                        </HBox>

                        <TableView fx:id="tableHebergements" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-border-color: #10b981; -fx-border-width: 1; -fx-border-radius: 20;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" text="ID" />
                                <TableColumn fx:id="colNom" text="Nom" />
                                <TableColumn fx:id="colType" text="Type" />
                                <TableColumn fx:id="colPrix" text="Prix/Nuit" />
                                <TableColumn fx:id="colAdresse" text="Adresse" />
                                <TableColumn fx:id="colNote" text="Note" />
                                <TableColumn fx:id="colDestination" text="Destination" />
                                <TableColumn fx:id="colAddedBy" text="Ajouté par" />
                                <TableColumn fx:id="colActions" text="Actions" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="12">
                                    <Label style="-fx-font-size: 32; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🏨" />
                                    <Label style="-fx-text-fill: #0f172a; -fx-font-size: 14" text="Aucun hébergement à afficher" />
                                </VBox>
                            </placeholder>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Label fx:id="lblPaginationInfo" style="-fx-text-fill: #0f172a; -fx-font-size: 12" text="0-0 sur 0 hébergements" />
                            <HBox fx:id="paginationContainer" spacing="4" />
                        </HBox>
                    </VBox>

                    <Region maxWidth="Infinity" minHeight="3" prefHeight="3" style="-fx-background-color: linear-gradient(to right, rgba(245,166,35,0.5), rgba(255,107,0,0.5), rgba(99,102,241,0.5));" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>