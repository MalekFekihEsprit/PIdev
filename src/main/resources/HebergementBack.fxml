                        </HBox>
                    </VBox>

                    <HBox minHeight="100" spacing="16">
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #10b981; -fx-border-width: 2; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(16,185,129,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🏨" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #0f172a; -fx-font-size: 12; -fx-font-weight: 500" text="TOTAL HÉBERGEMENTS" />
                                    <Label fx:id="lblHebergementsTotal" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #f87171; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(248,113,113,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🏷️" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #0f172a; -fx-font-size: 12; -fx-font-weight: 500;" text="TYPES" />
                                    <Label fx:id="lblTypesTotal" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #f87171;" text="0" />
                                </VBox>
                            </HBox>
                            <Label style="-fx-background-color: rgba(248,113,113,0.15); -fx-text-fill: #f87171; -fx-background-radius: 20; -fx-padding: 6 14; -fx-font-weight: 600; -fx-font-size: 11" text="🏷️ Types d'hébergement" />
                        </VBox>

                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #60a5fa; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(96,165,250,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🌍" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #0f172a; -fx-font-size: 12; -fx-font-weight: 500;" text="DESTINATIONS" />
