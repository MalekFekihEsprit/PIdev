                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ef4444; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
