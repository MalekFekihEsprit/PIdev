<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" style="-fx-background-color: #f8fafc;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ParticipationBackController">

    <!-- TOP NAV - DARK MODE WITH ORANGE ACCENT -->
    <top>
        <VBox>
            <!-- Main Navigation Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="16" left="32" right="32" top="16" /></padding>

                <HBox alignment="CENTER" spacing="10">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16" />
                    <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="TravelMate" />
                    <Label style="-fx-background-color: #ff8c42; -fx-text-fill: #0f172a; -fx-background-radius: 12; -fx-padding: 4 10; -fx-font-size: 10; -fx-font-weight: bold;" text="PRO" />
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Notifications with badge -->
                <HBox alignment="CENTER" style="-fx-background-color: #e2e8f0; -fx-background-radius: 50%; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;">
                    <Label style="-fx-font-size: 16;" text="🔔" />
                    <Circle fill="#ff8c42" radius="6" translateX="10" translateY="-10" />
                </HBox>

                <!-- User Profile - CLICKABLE -->
                <HBox alignment="CENTER" spacing="10" style="-fx-background-color: #e2e8f0; -fx-background-radius: 25; -fx-padding: 6 16 6 6; -fx-cursor: hand;">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16" />
                    <VBox spacing="0">
                        <Label style="-fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13;" text="Admin" />
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 10;" text="Administrateur" />
                    </VBox>
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="▼" />
                </HBox>
            </HBox>

            <!-- Secondary Navigation - Quick Filters -->
            <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 8 32;">
                <HBox alignment="CENTER" spacing="8">
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="FILTRES RAPIDES :" />
                    <Label style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-background-radius: 16; -fx-padding: 4 12; -fx-font-size: 11; -fx-cursor: hand;" text="Tous" />
                    <Label style="-fx-background-color: rgba(255,140,66,0.15); -fx-text-fill: #ff8c42; -fx-background-radius: 16; -fx-padding: 4 12; -fx-font-size: 11; -fx-cursor: hand;" text="VIP" />
                    <Label style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-background-radius: 16; -fx-padding: 4 12; -fx-font-size: 11; -fx-cursor: hand;" text="Organisateur" />
                    <Label style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-background-radius: 16; -fx-padding: 4 12; -fx-font-size: 11; -fx-cursor: hand;" text="Participant" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <!-- SIDEBAR DASHBOARD - DARK MODE WITH ORANGE -->
    <left>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
            <VBox prefWidth="220" spacing="8" style="-fx-background-color: #ffffff;">
                <padding><Insets bottom="24" left="20" right="20" top="24" /></padding>

                <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 13; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 1.5;" text="DASHBOARD" />

                <VBox spacing="4">
                    <padding><Insets top="16" /></padding>

                    <!-- Destinations -->
                    <HBox fx:id="btnDestinations" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="🌍" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Destinations" />
                    </HBox>

                    <!-- Hébergement -->
                    <HBox fx:id="btnHebergement" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="🏨" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Hébergement" />
                    </HBox>

                    <!-- Utilisateurs -->
                    <HBox fx:id="btnUsers" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="👥" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Utilisateurs" />
                    </HBox>

                    <!-- Statistiques -->
                    <HBox fx:id="btnStats" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="📊" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Statistiques" />
                    </HBox>

                    <!-- Itinéraires -->
                    <HBox fx:id="btnItineraires" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="🗺️" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Itinéraires" />
                    </HBox>

                    <!-- Catégories -->
                    <HBox fx:id="btnCategories" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="📑" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Catégories" />
                    </HBox>

                    <!-- Activités -->
                    <HBox fx:id="btnActivites" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="🏄" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Activités" />
                    </HBox>

                    <!-- Voyages -->
                    <HBox fx:id="btnVoyages" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;" onMouseClicked="#retourVoyages">
                        <Label style="-fx-font-size: 16;" text="✈️" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Voyages" />
                    </HBox>

                    <!-- Budgets -->
                    <HBox fx:id="btnBudgets" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="💰" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Budgets" />
                    </HBox>

                    <!-- Événements -->
                    <HBox fx:id="btnEvenements" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="🎉" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Événements" />
                    </HBox>

                    <!-- Participants - Active -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to right, #ff8c42, #ff6b4a); -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <Label style="-fx-font-size: 16;" text="👥" />
                        <Label style="-fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 14;" text="Participants" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSidebarParticipantsCount" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 2 8; -fx-text-fill: #0f172a; -fx-font-size: 11; -fx-font-weight: bold;" text="0" />
                    </HBox>
                </VBox>

                <!-- DIVIDER -->
                <Region maxWidth="Infinity" minHeight="3" prefHeight="3" style="-fx-background-color: linear-gradient(to right, rgba(245,166,35,0.5), rgba(255,107,0,0.5), rgba(99,102,241,0.5));" />

                <!-- STATS RAPIDES -->
                <VBox spacing="12" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 16;">
                    <Label style="-fx-font-weight: 600; -fx-text-fill: #64748b; -fx-font-size: 11; -fx-letter-spacing: 1;" text="STATISTIQUES GLOBALES" />
                    <GridPane hgap="10" vgap="10">
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total participants:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="statsTotalParticipants" style="-fx-font-weight: bold; -fx-text-fill: #ff8c42; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="VIP:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="statsVIPCount" style="-fx-font-weight: bold; -fx-text-fill: #f87171; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Organisateurs:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="statsOrganisateursCount" style="-fx-font-weight: bold; -fx-text-fill: #34d399; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Participants:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <Label fx:id="statsParticipantsCount" style="-fx-font-weight: bold; -fx-text-fill: #60a5fa; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <columnConstraints>
                            <ColumnConstraints />
                            <ColumnConstraints halignment="RIGHT" />
                        </columnConstraints>
                        <rowConstraints><RowConstraints /><RowConstraints /><RowConstraints /><RowConstraints /></rowConstraints>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- BOTTOM STATUS -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 10 28;">
            <Label style="-fx-text-fill: #ff8c42; -fx-font-size: 11; -fx-font-weight: 500;" text="● Connecté" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblLastUpdate" style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="Dernière mise à jour: 12 Fév 2026, 15:30" />
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="©️ 2026 TravelMate" />
        </HBox>
    </bottom>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background: #f8fafc; -fx-border-color: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="28"><padding><Insets bottom="60" left="36" right="36" top="36" /></padding>

                    <!-- EN-TÊTE DE LA PAGE -->
                    <VBox spacing="8">
                        <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Gestion des Participants" />
                        <HBox spacing="8">
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 14;" text="Administration des inscriptions aux voyages" />
                            <Label style="-fx-background-color: rgba(255,140,66,0.15); -fx-text-fill: #ff8c42; -fx-background-radius: 16; -fx-padding: 2 12; -fx-font-size: 12; -fx-font-weight: 600;" text="● Mode administration" />
                        </HBox>
                    </VBox>

                    <!-- EN-TÊTE DU VOYAGE -->
                    <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 20;">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox alignment="CENTER" style="-fx-background-color: rgba(255,140,66,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                <Label style="-fx-font-size: 24;" text="👥" />
                            </VBox>
                            <VBox spacing="4">
                                <Label style="-fx-font-size: 14; -fx-font-weight: 600; -fx-text-fill: #0f172a;" text="Voyage sélectionné" />
                                <Label fx:id="lblTitreVoyage" style="-fx-font-family: 'Clash Display'; -fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #ff8c42;" />
                                <HBox spacing="20">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="📍" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;" />
                                        <Label fx:id="lblDestinationVoyage" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" />
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="📅" style="-fx-font-size: 12; -fx-text-fill: #94a3b8;" />
                                        <Label fx:id="lblDatesVoyage" style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" />
                                    </HBox>
                                </HBox>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnRetour" style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13; -fx-padding: 8 16; -fx-background-radius: 8; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-cursor: hand;" text="← Retour aux voyages" />
                        </HBox>
                    </VBox>

                    <!-- STATISTIQUES PAR RÔLE (cards) -->
                    <HBox minHeight="100" spacing="16">
                        <!-- Carte VIP -->
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ff8c42; -fx-border-width: 2; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(255,140,66,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24;" text="👑" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="VIP" />
                                    <Label fx:id="lblCountVIP" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                                    <Label fx:id="lblPourcentVIP" style="-fx-text-fill: #ff8c42; -fx-font-size: 11;" text="(0%)" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Organisateurs -->
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #10b981; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(16,185,129,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24;" text="🎯" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="ORGANISATEURS" />
                                    <Label fx:id="lblCountOrganisateur" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #10b981;" text="0" />
                                    <Label fx:id="lblPourcentOrganisateur" style="-fx-text-fill: #10b981; -fx-font-size: 11;" text="(0%)" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Participants -->
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #3b82f6; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(59,130,246,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24;" text="👥" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="PARTICIPANTS" />
                                    <Label fx:id="lblCountParticipant" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #3b82f6;" text="0" />
                                    <Label fx:id="lblPourcentParticipant" style="-fx-text-fill: #3b82f6; -fx-font-size: 11;" text="(0%)" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Guides -->
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ec4899; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(236,72,153,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24;" text="🧭" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="GUIDES" />
                                    <Label fx:id="lblCountGuide" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ec4899;" text="0" />
                                    <Label fx:id="lblPourcentGuide" style="-fx-text-fill: #ec4899; -fx-font-size: 11;" text="(0%)" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Carte Chauffeurs -->
                        <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #a855f7; -fx-border-width: 1; -fx-border-radius: 20;" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(168,85,247,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                    <Label style="-fx-font-size: 24;" text="🚌" />
                                </VBox>
                                <VBox spacing="4">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="CHAUFFEURS" />
                                    <Label fx:id="lblCountChauffeur" style="-fx-font-family: 'Clash Display'; -fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #a855f7;" text="0" />
                                    <Label fx:id="lblPourcentChauffeur" style="-fx-text-fill: #a855f7; -fx-font-size: 11;" text="(0%)" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- TOTAL CARD -->
                    <VBox spacing="16" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #f8fafc); -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ff8c42; -fx-border-width: 2; -fx-border-radius: 20;">
                        <HBox alignment="CENTER" spacing="12">
                            <VBox alignment="CENTER" style="-fx-background-color: rgba(255,140,66,0.15); -fx-background-radius: 14; -fx-min-width: 48; -fx-min-height: 48;">
                                <Label style="-fx-font-size: 24;" text="📊" />
                            </VBox>
                            <VBox alignment="CENTER" spacing="4">
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-weight: 500;" text="TOTAL PARTICIPANTS" />
                                <Label fx:id="lblTotalParticipants" style="-fx-font-family: 'Clash Display'; -fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- FORMULAIRE D'AJOUT -->
                    <VBox spacing="16" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 20;">
                        <Label style="-fx-font-size: 18; -fx-font-weight: 600; -fx-text-fill: #0f172a;" text="➕ Ajouter un participant" />

                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="45" />
                                <ColumnConstraints percentWidth="35" />
                                <ColumnConstraints percentWidth="20" />
                            </columnConstraints>

                            <VBox spacing="8" GridPane.columnIndex="0">
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Email" />
                                <TextField fx:id="tfEmail" promptText="email@exemple.com" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-background-radius: 8; -fx-padding: 10;" />
                            </VBox>

                            <VBox spacing="8" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Rôle" />
                                <ComboBox fx:id="cbRole" promptText="Sélectionner un rôle" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-background-radius: 8;" />
                            </VBox>

                            <VBox alignment="BOTTOM_RIGHT" GridPane.columnIndex="2">
                                <Button fx:id="btnAjouterParticipation" style="-fx-background-color: #ff8c42; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 14; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Ajouter" />
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- SECTION RECHERCHE AVANCÉE -->
                    <VBox spacing="16" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-padding: 24; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 20;">
                        <Label style="-fx-font-size: 18; -fx-font-weight: 600; -fx-text-fill: #0f172a;" text="🔍 Recherche avancée" />

                        <GridPane hgap="15" vgap="10">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="20" />
                                <ColumnConstraints percentWidth="30" />
                                <ColumnConstraints percentWidth="20" />
                                <ColumnConstraints percentWidth="30" />
                            </columnConstraints>

                            <!-- Recherche par ID participation -->
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="ID Participation:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="tfSearchIdParticipation" promptText="ID exact" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <!-- Recherche par rôle -->
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Rôle:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                            <ComboBox fx:id="cbSearchRole" style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-background-radius: 8;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                            <!-- Recherche par email -->
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <TextField fx:id="tfSearchEmail" promptText="Rechercher par email..." style="-fx-background-color: #f8fafc; -fx-text-fill: #0f172a; -fx-background-radius: 8; -fx-padding: 10;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <!-- Boutons de recherche -->
                            <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="1">
                                <Button fx:id="btnSearchParticipation" style="-fx-background-color: #ff8c42; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13; -fx-padding: 10 16; -fx-background-radius: 8; -fx-cursor: hand;" text="🔍 Rechercher" />
                                <Button fx:id="btnResetParticipation" style="-fx-background-color: #64748b; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13; -fx-padding: 10 16; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Réinitialiser" />
                            </HBox>
                        </GridPane>
                    </VBox>

                    <!-- TABLEAU DES PARTICIPANTS -->
                    <VBox spacing="16">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 24; -fx-font-weight: 600; -fx-text-fill: #0f172a;" text="Liste des participants" />
                            <Label fx:id="lblParticipantsCount" style="-fx-background-color: rgba(255,140,66,0.15); -fx-text-fill: #ff8c42; -fx-background-radius: 20; -fx-padding: 6 14; -fx-font-weight: 600; -fx-font-size: 11;" text="0 participants" />
                        </HBox>

                        <TableView fx:id="tableParticipations" style="-fx-background-color: #e2e8f0; -fx-background-radius: 20; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 20;">
                            <columns>
                                <TableColumn fx:id="colIdParticipation" text="ID" sortable="true" />
                                <TableColumn fx:id="colIdUser" text="User ID" sortable="true" />
                                <TableColumn fx:id="colEmail" text="Email" sortable="true" />
                                <TableColumn fx:id="colNom" text="Nom" sortable="true" />
                                <TableColumn fx:id="colPrenom" text="Prénom" sortable="true" />
                                <TableColumn fx:id="colRole" text="Rôle" sortable="true" />
                                <TableColumn fx:id="colActions" text="Actions" />
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="12">
                                    <Label style="-fx-font-size: 32;" text="👥" />
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 14;" text="Aucun participant pour ce voyage" />
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- BOTTOM DECORATION -->
                    <Region maxWidth="Infinity" minHeight="3" prefHeight="3" style="-fx-background-color: linear-gradient(to right, rgba(245,166,35,0.5), rgba(255,107,0,0.5), rgba(99,102,241,0.5));" />
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>