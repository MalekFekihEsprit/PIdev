<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: #f8fafc;"
            stylesheets="Styles/budget-dark.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.BudgetBackController">

    <!-- ═══════════ TOP NAV ═══════════ -->
    <top>
        <VBox>
            <HBox alignment="CENTER_LEFT" spacing="20"
                style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="16" left="32" right="32" top="16"/></padding>
                <!-- Logo -->
                <HBox alignment="CENTER" spacing="10">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16"/>
                    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="TravelMate"/>
                    <Label style="-fx-background-color: #ff8c42; -fx-text-fill: #0f172a; -fx-background-radius: 12; -fx-padding: 3 10; -fx-font-size: 10; -fx-font-weight: bold;" text="ADMIN"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- User Profile - Clickable -->
                <HBox fx:id="userProfileBox" alignment="CENTER" spacing="10"
                      style="-fx-background-color: #e2e8f0; -fx-background-radius: 25; -fx-padding: 6 16 6 6; -fx-cursor: hand;">
                    <Circle fill="linear-gradient(from 0% 0% to 100% 100%, #ff8c42, #ff6b4a)" radius="16"/>
                    <VBox spacing="0">
                        <Label fx:id="lblUserName" style="-fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 13;" text="Administrateur"/>
                        <Label fx:id="lblUserRole" style="-fx-text-fill: #64748b; -fx-font-size: 10;" text="Super Admin"/>
                    </VBox>
                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="▼"/>
                </HBox>
            </HBox>
            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0; -fx-padding: 8 32;">
                <Label style="-fx-text-fill: #ff8c42; -fx-font-size: 12; -fx-font-weight: 600" text="💰 Gestion des Budgets"/>
                <Label style="-fx-text-fill: #e2e8f0; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="›"/>
                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12" text="Analyse Financière"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblUpdateTime" style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <!-- SIDEBAR DASHBOARD - DARK MODE WITH ORANGE -->
    <!-- SIDEBAR DASHBOARD - SVGPath icons, zero font dependency -->
    <left>
        <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background: #ffffff; -fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
            <VBox prefWidth="220" spacing="8" style="-fx-background-color: #ffffff;">
                <padding><Insets bottom="24" left="20" right="20" top="24" /></padding>

                <Label style="-fx-font-family: 'Clash Display'; -fx-font-size: 13; -fx-font-weight: 700; -fx-text-fill: #64748b; -fx-letter-spacing: 1.5;" text="DASHBOARD" />

                <VBox spacing="4">
                    <padding><Insets top="16" /></padding>

                    <!-- Destinations -->
                    <HBox fx:id="btnDestinations" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Destinations" />
                    </HBox>

                    <!-- Hébergement -->
                    <HBox fx:id="btnHebergement" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H3V5H1v15h2v-3h18v3h2v-9c0-2.21-1.79-4-4-4z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Hébergement" />
                    </HBox>

                    <!-- Utilisateurs -->
                    <HBox fx:id="btnUsers" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Utilisateurs" />
                    </HBox>

                    <!-- Statistiques -->
                    <HBox fx:id="btnStats" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Statistiques" />
                    </HBox>

                    <!-- Itinéraires -->
                    <HBox fx:id="btnItineraires" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Itinéraires" />
                    </HBox>

                    <!-- Catégories -->
                    <HBox fx:id="btnCategories" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Catégories" />
                    </HBox>

                    <!-- Activités -->
                    <HBox fx:id="btnActivites" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M13.49 5.48c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm-3.6 13.9l1-4.4 2.1 2v6h2v-7.5l-2.1-2 .6-3c1.3 1.5 3.3 2.5 5.5 2.5v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1l-5.2 2.2v4.7h2v-3.4l1.8-.7-1.6 8.1-4.9-1-.4 2 7 1.4z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Activités" />
                    </HBox>

                    <!-- Voyages -->
                    <HBox fx:id="btnVoyages" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M21 16v-2l-8-5V3.5c0-.83-.67-1.5-1.5-1.5S10 2.67 10 3.5V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Voyages" />
                    </HBox>

                    <!-- Budgets - Active -->
                    <HBox fx:id="btnBudgets" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: linear-gradient(to right, #ff8c42, #ff6b4a); -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" fill="white" scaleX="0.75" scaleY="0.75" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSidebarBudgetCount" style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 10; -fx-padding: 2 8; -fx-text-fill: #0f172a; -fx-font-size: 11; -fx-font-weight: bold;" text="0" />
                        <Label style="-fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 14;" text="Budgets" />
                    </HBox>

                    <!-- Événements -->
                    <HBox fx:id="btnEvenements" alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: transparent; -fx-background-radius: 12; -fx-padding: 12 16; -fx-cursor: hand;">
                        <SVGPath content="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm4.24 16L12 15.45 7.77 18l1.12-4.81-3.73-3.23 4.92-.42L12 5l1.92 4.53 4.92.42-3.73 3.23L16.23 18z" fill="#94a3b8" scaleX="0.75" scaleY="0.75" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-weight: 500; -fx-font-size: 14;" text="Événements" />
                    </HBox>

                </VBox>

                <!-- DIVIDER -->
                <Region maxWidth="Infinity" minHeight="3" prefHeight="3" style="-fx-background-color: linear-gradient(to right, rgba(245,166,35,0.5), rgba(255,107,0,0.5), rgba(99,102,241,0.5));" />

                <VBox spacing="12" style="-fx-background-color: #f8fafc; -fx-background-radius: 16; -fx-padding: 16; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 16;">
                    <Label style="-fx-font-weight: 600; -fx-text-fill: #64748b; -fx-font-size: 11; -fx-letter-spacing: 1;" text="STATISTIQUES BUDGETS" />
                    <GridPane hgap="10" vgap="10">
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Total budgets :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label fx:id="lblTotalBudgetsCard" style="-fx-font-weight: bold; -fx-text-fill: #ff8c42; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Actifs :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <Label fx:id="lblActifsCard" style="-fx-font-weight: bold; -fx-text-fill: #34d399; -fx-font-size: 12;" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Montant global :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <Label fx:id="lblGlobalCard" style="-fx-font-weight: bold; -fx-text-fill: #f87171; -fx-font-size: 12; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="0 €" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <columnConstraints><ColumnConstraints /><ColumnConstraints halignment="RIGHT" /></columnConstraints>
                        <rowConstraints><RowConstraints /><RowConstraints /><RowConstraints /></rowConstraints>
                    </GridPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </left>

    <!-- ═══════════ STATUS BAR ═══════════ -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 1 0 0 0; -fx-padding: 10 28;">
            <Label style="-fx-text-fill: #ff8c42; -fx-font-size: 11; -fx-font-weight: 600" text="● Connecté"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblLastUpdate" style="-fx-text-fill: #64748b; -fx-font-size: 11; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="—"/>
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11" text="© 2026 TravelMate"/>
        </HBox>
    </bottom>

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <center>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background: #f8fafc; -fx-border-color: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="24">
                    <padding><Insets bottom="60" left="32" right="32" top="32"/></padding>

                    <!-- ── PAGE HEADER ── -->
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4">
                            <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #0f172a;"
                                   text="Gestion des Budgets"/>
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;"
                                   text="Supervision complète des budgets et dépenses de voyage"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cmbVoyageSelector"
                                  style="-fx-background-color: #e2e8f0; -fx-text-fill: #0f172a; -fx-border-color: #ff8c42; -fx-border-radius: 10; -fx-background-radius: 10;"/>
                    </HBox>

                    <!-- ── KPI CARDS ── -->
                    <HBox minHeight="100" spacing="16">
                        <!-- Total budgets -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 18; -fx-padding: 22; -fx-border-color: #ff8c42; -fx-border-width: 2; -fx-border-radius: 18;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(255,140,66,0.15); -fx-background-radius: 12; -fx-min-width: 46; -fx-min-height: 46;">
                                    <Label style="-fx-font-size: 22; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="💰"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;" text="TOTAL BUDGETS"/>
                                    <Label fx:id="lblTotalBudgetsKpi" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="0"/>
                                </VBox>
                            </HBox>
                        </VBox>
                        <!-- Actifs -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 18; -fx-padding: 22; -fx-border-color: #34d399; -fx-border-width: 1; -fx-border-radius: 18;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(52,211,153,0.15); -fx-background-radius: 12; -fx-min-width: 46; -fx-min-height: 46;">
                                    <Label style="-fx-font-size: 22; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="✅"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;" text="BUDGETS ACTIFS"/>
                                    <Label fx:id="lblActifsKpi" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #34d399;" text="0"/>
                                </VBox>
                            </HBox>
                            <Label style="-fx-background-color: rgba(52,211,153,0.12); -fx-text-fill: #34d399; -fx-background-radius: 20; -fx-padding: 4 12; -fx-font-size: 11; -fx-font-weight: 600" text="✓ Statut ACTIF"/>
                        </VBox>
                        <!-- Montant global -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 18; -fx-padding: 22; -fx-border-color: #f87171; -fx-border-width: 1; -fx-border-radius: 18;">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox alignment="CENTER" style="-fx-background-color: rgba(248,113,113,0.15); -fx-background-radius: 12; -fx-min-width: 46; -fx-min-height: 46;">
                                    <Label style="-fx-font-size: 22; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📊"/>
                                </VBox>
                                <VBox spacing="3">
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 600;" text="MONTANT GLOBAL"/>
                                    <Label fx:id="lblGlobalKpi" style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f87171; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="0 €"/>
                                </VBox>
                            </HBox>
                            <Label style="-fx-background-color: rgba(248,113,113,0.12); -fx-text-fill: #f87171; -fx-background-radius: 20; -fx-padding: 4 12; -fx-font-size: 11; -fx-font-weight: 600" text="💸 Tous budgets confondus"/>
                        </VBox>
                    </HBox>

                    <!-- ── BUDGETS TABLE ── -->
                    <VBox spacing="14">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 20; -fx-font-weight: 700; -fx-text-fill: #0f172a;" text="Liste des Budgets"/>
                            <Label fx:id="lblBudgetCount"
                                   style="-fx-background-color: rgba(255,140,66,0.15); -fx-text-fill: #ff8c42; -fx-background-radius: 20; -fx-padding: 4 14; -fx-font-weight: 600; -fx-font-size: 11;"
                                   text="0 budgets"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <TableView fx:id="tableBudgets"
                                   style="-fx-background-color: #e2e8f0; -fx-background-radius: 16; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 16;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colIdBudget"  text="ID"/>
                                <TableColumn fx:id="colLibelleBudget" text="Libellé"/>
                                <TableColumn fx:id="colMontantTotal" text="Montant total"/>
                                <TableColumn fx:id="colDeviseBudget"  text="Devise"/>
                                <TableColumn fx:id="colStatutBudget" text="Statut"/>
                                <TableColumn fx:id="colVoyageAssocie" text="Voyage"/>
                                <TableColumn fx:id="colDestination" text="Destination"/>
                                <TableColumn fx:id="colActionsBudget"  text="Actions"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="10">
                                    <Label style="-fx-font-size: 30; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="💰"/>
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13" text="Aucun budget à afficher"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- ════════════════════════════════════════════
                         ANALYSE FINANCIÈRE COMPLÈTE
                         ════════════════════════════════════════════ -->
                    <VBox spacing="20"
                          style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 20; -fx-padding: 28; -fx-border-color: #ff8c42; -fx-border-width: 1; -fx-border-radius: 20;">

                        <!-- Titre -->
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <VBox alignment="CENTER"
                                  style="-fx-background-color: rgba(255,140,66,0.15); -fx-background-radius: 14; -fx-min-width: 50; -fx-min-height: 50;">
                                <Label style="-fx-font-size: 24; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📈"/>
                            </VBox>
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 20; -fx-font-weight: 700; -fx-text-fill: #0f172a;"
                                       text="Analyse Financière Globale"/>
                                <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;"
                                       text="Vue consolidée de tous les budgets et dépenses"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblAnalyseDate"
                                   style="-fx-background-color: rgba(255,140,66,0.12); -fx-text-fill: #ff8c42; -fx-background-radius: 20; -fx-padding: 5 14; -fx-font-size: 11; -fx-font-weight: 600;"
                                   text="Mis à jour : —"/>
                        </HBox>

                        <!-- 4 KPI financiers -->
                        <HBox spacing="14">
                            <!-- Total dépensé -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #f87171; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="💸"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700" text="TOTAL DÉPENSÉ"/>
                                </HBox>
                                <Label fx:id="lblAnalyseTotalDepense"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f87171;" text="0,00 €"/>
                                <Label fx:id="lblAnalyseTotalDepenseSub"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="sur tous les budgets"/>
                            </VBox>
                            <!-- Budget alloué -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #ff8c42; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="💰"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700" text="BUDGET ALLOUÉ"/>
                                </HBox>
                                <Label fx:id="lblAnalyseBudgetTotal"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #ff8c42;" text="0,00 €"/>
                                <Label fx:id="lblAnalyseBudgetNb"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="0 budget(s)"/>
                            </VBox>
                            <!-- Solde restant -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #34d399; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="✅"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700;" text="SOLDE RESTANT"/>
                                </HBox>
                                <Label fx:id="lblAnalyseSolde"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #34d399;" text="0,00 €"/>
                                <Label fx:id="lblAnalyseSoldePct"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="0% disponible"/>
                            </VBox>
                            <!-- Moyenne / budget -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #818cf8; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📐"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700" text="DÉPENSE MOYENNE"/>
                                </HBox>
                                <Label fx:id="lblAnalyseMoyenne"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #818cf8;" text="0,00 €"/>
                                <Label fx:id="lblAnalyseMoyenneSub"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="par budget"/>
                            </VBox>
                        </HBox>


                        <!-- ── 3 indicateurs : Moyenne/jour | Jour le plus dépensier | Projection ── -->
                        <HBox spacing="14">

                            <!-- Dépense moyenne par jour (calculée sur la durée du voyage) -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #38bdf8; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📅"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700" text="DÉPENSE MOYENNE / JOUR"/>
                                </HBox>
                                <Label fx:id="lblMoyenneParJour"
                                       style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #38bdf8;" text="— €/j"/>
                                <Label fx:id="lblMoyenneParJourSub"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="durée du voyage : — jours"/>
                            </VBox>

                            <!-- Jour le plus dépensier -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #f59e0b; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🔥"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700" text="JOUR LE PLUS DÉPENSIER"/>
                                </HBox>
                                <Label fx:id="lblJourPlusDep"
                                       style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #f59e0b;" text="—"/>
                                <Label fx:id="lblJourPlusDepMontant"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="—"/>
                            </VBox>

                            <!-- Projection dépassement -->
                            <VBox spacing="8" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #f87171; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="🚨"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700;" text="PROJECTION"/>
                                </HBox>
                                <Label fx:id="lblProjection"
                                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #f87171;" text="—" wrapText="true"/>
                                <Label fx:id="lblProjectionSub"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="basé sur le rythme actuel" wrapText="true"/>
                            </VBox>

                            <!-- Taux d'utilisation global avec barre colorée -->
                            <VBox spacing="10" HBox.hgrow="ALWAYS"
                                  style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18; -fx-border-color: #a78bfa; -fx-border-width: 0 0 0 3; -fx-border-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label style="-fx-font-size: 18; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📊"/>
                                    <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 11; -fx-font-weight: 700;" text="TAUX D'UTILISATION"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="lblTauxUtilisation"
                                           style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #a78bfa;" text="0%"/>
                                    <Label fx:id="lblTauxUtilisationEtat"
                                           style="-fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 11; -fx-font-weight: 700;" text="—"/>
                                </HBox>
                                <StackPane
                                        style="-fx-background-color: #e2e8f0; -fx-background-radius: 6;">
                                    <Rectangle fx:id="rectTauxBar" arcHeight="6" arcWidth="6" height="10" width="0"
                                               style="-fx-fill: #a78bfa;">
                                        <StackPane.alignment>CENTER_LEFT</StackPane.alignment>
                                    </Rectangle>
                                </StackPane>
                                <Label fx:id="lblTauxUtilisationSub"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 11;" text="du budget total consommé"/>
                            </VBox>

                        </HBox>

                        <!-- Résumé tabulaire par budget -->
                        <VBox spacing="10"
                              style="-fx-background-color: #f8fafc; -fx-background-radius: 14; -fx-padding: 18;">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 15; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📋"/>
                                <Label style="-fx-text-fill: #0f172a; -fx-font-size: 14; -fx-font-weight: 700" text="Résumé par budget — taux de consommation"/>
                                <Region HBox.hgrow="ALWAYS"/>
                            </HBox>
                            <TableView fx:id="tableAnalyse"
                                       style="-fx-background-color: transparent; -fx-border-color: #e2e8f0;">
                                <columns>
                                    <TableColumn fx:id="colAnalyseNom" text="Budget"/>
                                    <TableColumn fx:id="colAnalyseAlloue" text="Alloué"/>
                                    <TableColumn fx:id="colAnalyseDepense" text="Dépensé"/>
                                    <TableColumn fx:id="colAnalyseSolde" text="Solde"/>
                                    <TableColumn fx:id="colAnalyseTaux"  text="Taux"/>
                                    <TableColumn fx:id="colAnalyseStatut"  text="Statut"/>
                                </columns>
                                <placeholder>
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;"
                                           text="Sélectionnez un budget pour voir l'analyse"/>
                                </placeholder>
                            </TableView>
                        </VBox>
                    </VBox>
                    <!-- ════ FIN ANALYSE ════ -->

                    <!-- ── PIE CHART ── -->
                    <VBox spacing="14"
                          style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 18; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 18;">
                        <Label style="-fx-font-size: 17; -fx-font-weight: 700; -fx-text-fill: #0f172a;"
                               text="📊 Répartition des dépenses par catégorie"/>
                        <PieChart fx:id="pieChartDepenses"
                                  style="-fx-background-color: transparent;" prefHeight="220" prefWidth="260"/>
                    </VBox>

                    <!-- ── DÉPENSES TABLE ── -->
                    <VBox spacing="16"
                          style="-fx-background-color: linear-gradient(to bottom right,#ffffff,#f8fafc); -fx-background-radius: 18; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 18;">

                        <!-- Header -->
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 18; -fx-font-weight: 700; -fx-text-fill: #0f172a;"
                                   text="Dépenses du budget sélectionné"/>
                            <Label fx:id="lblNbDepenses"
                                   style="-fx-background-color: rgba(255,140,66,0.15); -fx-text-fill: #ff8c42; -fx-background-radius: 20; -fx-padding: 4 12; -fx-font-weight: 600; -fx-font-size: 11;"
                                   text="0 dépense"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>

                        <!-- Filtres -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12" text="Catégorie :"/>
                            <ComboBox fx:id="cmbFiltreCategorie"/>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Du :"/>
                            <DatePicker fx:id="dpDateDebut"/>
                            <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12;" text="Au :"/>
                            <DatePicker fx:id="dpDateFin"/>
                            <Button fx:id="btnAppliquerFiltres" onAction="#handleAppliquerFiltres"
                                    style="-fx-background-color: #ff8c42; -fx-text-fill: #0f172a; -fx-font-weight: 600; -fx-font-size: 12; -fx-padding: 7 14; -fx-background-radius: 8; -fx-cursor: hand;"
                                    text="🔍 Appliquer"/>
                            <Button fx:id="btnReinitialiserFiltres" onAction="#handleReinitialiserFiltres"
                                    style="-fx-background-color: #e2e8f0; -fx-text-fill: #94a3b8; -fx-font-weight: 600; -fx-font-size: 12; -fx-padding: 7 14; -fx-background-radius: 8; -fx-cursor: hand;"
                                    text="↺ Réinitialiser"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12;" text="Trier :"/>
                            <ToggleButton fx:id="btnTriMontant" onAction="#handleTriMontant" text="Montant"/>
                            <ToggleButton fx:id="btnTriDate"    onAction="#handleTriDate"    text="Date"/>
                            <ToggleButton fx:id="btnTriLibelle" onAction="#handleTriLibelle" text="Libellé"/>
                        </HBox>

                        <!-- Table -->
                        <TableView fx:id="tableDepenses"
                                   style="-fx-background-color: #f8fafc; -fx-background-radius: 10; -fx-border-color: #e2e8f0;"
                                   VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colDepenseLibelle" text="Libellé"/>
                                <TableColumn fx:id="colDepenseCategorie" text="Catégorie"/>
                                <TableColumn fx:id="colDepenseMontant" text="Montant"/>
                                <TableColumn fx:id="colDepenseDevise"  text="Devise"/>
                                <TableColumn fx:id="colDepenseDate"  text="Date"/>
                                <TableColumn fx:id="colDepensePaiement" text="Paiement"/>
                                <TableColumn fx:id="colDepenseDescription" text="Description"/>
                            </columns>
                            <placeholder>
                                <VBox alignment="CENTER" spacing="10">
                                    <Label style="-fx-font-size: 30; -fx-font-family: 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji';" text="📋"/>
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13;"
                                           text="Sélectionnez un budget pour voir ses dépenses"/>
                                </VBox>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- Bottom accent -->
                    <Region maxWidth="Infinity" minHeight="3" prefHeight="3" style="-fx-background-color: linear-gradient(to right, rgba(245,166,35,0.5), rgba(255,107,0,0.5), rgba(99,102,241,0.5));" />

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>